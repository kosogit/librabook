# Shared /api backend is enabled by default. Never put secrets in VITE_ variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Leave these blank for offline-only payments. Use Razorpay test keys locally.
# Configure automatic capture in Razorpay, and payment.captured / order.paid webhooks.
# Webhook URL: https://your-domain.example/api/payments/webhook
# Set true only to preview the old, browser-only demo:
# VITE_BROWSER_DEMO=true
# VITE_API_BASE_URL=https://your-api.example.com
# Server-only settings (.env is loaded automatically):
# LIBRA_DATA_FILE=/persistent/storage/workspace.json
# NODE_ENV=production
